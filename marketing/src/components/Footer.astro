---
import { footer, site, BRAND_PATH } from "../lib/site";
const year = new Date().getFullYear();
---

<footer>
  <div class="wrap">
    <div class="foot">
      <div class="about">
        <a class="brand" href="/"><span class="mark"><svg viewBox="0 0 24 24"><path d={BRAND_PATH} /></svg></span>RadioPad</a>
        <p>AI-assisted radiology reporting. RadioPad drafts and validates. The radiologist reviews and signs.</p>
        <p class="foot-mail"><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      {Object.entries(footer).map(([group, links]) => (
        <div>
          <h5>{group}</h5>
          <ul>{links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </div>
      ))}
    </div>
    <div class="foot-b"><span>© {year} RadioPad</span><span>Drafted by RadioPad. Signed by radiologists.</span></div>
  </div>
</footer>
