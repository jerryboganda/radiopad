---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHead from "../components/SectionHead.astro";
import Divider from "../components/Divider.astro";
import CtaBand from "../components/CtaBand.astro";
import Icon from "../components/Icon.astro";
import Integrations from "../components/home/Integrations.astro";

// One illustrative report, rendered the way the exporters do (see FhirDiagnosticReportSerializer).
const sections: [string, string][] = [
  ["Indication", "Follow-up of a right lower lobe nodule."],
  ["Technique", "CT chest without contrast. Axial 1 mm reconstructions in lung and soft-tissue windows."],
  ["Comparison", "CT chest, 12 months prior."],
  ["Findings", "6 mm solid nodule in the right lower lobe, unchanged. No pleural effusion. No mediastinal lymphadenopathy."],
  ["Impression", "Stable 6 mm solid nodule, right lower lobe."],
  ["Recommendations", "Recommend follow-up imaging as clinically indicated."],
];
const narrative = sections.map(([t, c]) => `${t.toUpperCase()}:\n${c}`).join("\n\n");
const id = "7c9e6679-7425-40de-944b-e07fc1f90ae7";
const report = {
  resourceType: "DiagnosticReport",
  id,
  meta: { profile: ["http://hl7.org/fhir/StructureDefinition/DiagnosticReport"], source: "urn:radiopad:tenant:your-tenant" },
  identifier: [
    { system: "urn:radiopad:report", value: id },
    { system: "urn:radiopad:accession", value: "ACC-000123" },
  ],
  status: "final",
  category: [{ coding: [{ system: "http://terminology.hl7.org/CodeSystem/v2-0074", code: "RAD", display: "Radiology" }] }],
  code: { coding: [{ system: "urn:radiopad:modality-bodypart", code: "ct:chest", display: "CT Chest" }], text: "CT Chest" },
  subject: { reference: "Patient/example" },
  effectiveDateTime: "2026-11-21T09:42:00.0000000Z",
  issued: "2026-11-21T09:44:10.0000000Z",
  conclusion: sections[4][1],
  presentedForm: [{ contentType: "text/plain", data: btoa(narrative).slice(0, 40) + "…", title: "RadioPad narrative" }],
};
// Minimal JSON highlighter: keys get .k, string values .s (site.css code tokens).
const json = JSON.stringify(report, null, 2)
  .replace(/[&<>]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" })[c]!)
  .replace(/("(?:[^"\\]|\\.)*")(\s*:)?/g, (_, str, colon) => (colon ? `<span class="k">${str}</span>${colon}` : `<span class="s">${str}</span>`));
const docs = [
  { id: "pdf", tab: "PDF", file: "report.pdf", note: "Print-ready layout" },
  { id: "docx", tab: "DOCX", file: "report.docx", note: "Editable document" },
];

const connectors = [
  { name: "dicomweb-qido", scope: "net:dicomweb", desc: "Looks up a DICOM study by accession number over QIDO-RS." },
  { name: "pacs-recent-studies", scope: "net:dicomweb", desc: "Returns up to 20 recent studies for a patient within a day window." },
  { name: "fhir-servicerequest", scope: "net:fhir-read", desc: "Reads a ServiceRequest from your configured FHIR server." },
];
const cli = [
  "radiopad rulebook validate chest_ct_v1.yaml",
  "radiopad rulebook test chest_ct_v1.yaml --cases ./cases",
  "radiopad audit verify",
];
---

<BaseLayout
  title="Integrations"
  description="Connect RadioPad to PACS and RIS, DICOMweb, Orthanc, FHIR R4, your identity provider and your choice of AI model, with signed connectors and a CLI."
>
  <PageHero
    crumbs={[{ label: "Integrations", href: "/integrations/" }]}
    eyebrow="Integrations"
    lead="Studies in. Signed reports out."
    title="On the standards your stack speaks."
    text="RadioPad reads study context from your PACS over DICOMweb, bridges to Orthanc, signs you in through your identity provider and exports every signed report as FHIR R4 DiagnosticReport, PDF, DOCX or plain text."
  />
  <Divider />
  <Integrations />
  <Divider />

  <section class="sec" id="imaging">
    <div class="wrap">
      <SectionHead eyebrow="Imaging in" title="Study context from the systems you already run." />
      <div class="grid grid-3">
        <article class="card beam" data-reveal>
          <span class="ic"><Icon name="server" /></span>
          <h3>PACS/RIS bridge</h3>
          <p>The Windows app includes a PACS/RIS bridge, backed by a vendor-neutral DICOMweb proxy on the server.</p>
          <ul class="ticks">
            <li><Icon name="check" />Search studies over QIDO-RS, forward instances with STOW-RS</li>
            <li><Icon name="check" />A health check reports DICOMweb and Orthanc reachability</li>
            <li><Icon name="check" />Accession numbers stay out of the audit log, kept as a short hash prefix</li>
          </ul>
        </article>
        <article class="card" data-reveal>
          <span class="ic"><Icon name="globe" /></span>
          <h3>DICOMweb, QIDO and WADO</h3>
          <p>Study context comes from the PACS configured for your tenant, through QIDO-RS search and WADO-RS instance metadata.</p>
          <ul class="ticks">
            <li><Icon name="check" />Base URL and bearer set per tenant</li>
            <li><Icon name="check" />Secrets are write-only through the API</li>
            <li><Icon name="check" />Every study-context fetch is audited</li>
          </ul>
        </article>
        <article class="card" data-reveal>
          <span class="ic"><Icon name="stack" /></span>
          <h3>Orthanc bridge</h3>
          <p>An opt-in Orthanc profile for self-hosted deployments, wired to RadioPad with Lua hooks.</p>
          <ul class="ticks">
            <li><Icon name="check" />Notifies RadioPad when a study is stable and when a structured report is stored</li>
            <li><Icon name="check" />Converts between HL7 v2 and DICOM SR</li>
            <li><Icon name="check" />Binds to 127.0.0.1 by default</li>
          </ul>
        </article>
      </div>
    </div>
  </section>
  <Divider />

  <section class="sec" id="fhir">
    <div class="wrap">
      <SectionHead eyebrow="Reports out" title="One signed report. Four formats." sub="The radiologist signs once. The same report leaves as a FHIR R4 DiagnosticReport for the EHR, or as PDF, DOCX or plain text." />
      <div class="split fx">
        <div data-reveal>
          <h3>Mapped to FHIR R4, field by field.</h3>
          <p class="d">Exports marked final require the radiologist's acknowledgement. Inbound DiagnosticReports can be ingested too, and FHIR webhooks are checked against an HMAC signature.</p>
          <dl class="specs">
            <div><dt>status</dt><dd>preliminary while in draft, final once acknowledged</dd></div>
            <div><dt>code</dt><dd>Modality and body part</dd></div>
            <div><dt>conclusion</dt><dd>The impression</dd></div>
            <div><dt>presentedForm</dt><dd>The full narrative, every section</dd></div>
            <div><dt>identifier</dt><dd>Report id and accession number</dd></div>
          </dl>
        </div>
        <div data-tabs data-reveal>
          <div class="tabs" role="tablist" aria-label="Export formats">
            <span class="tab-ind" aria-hidden="true"></span>
            <button class="tab" role="tab" id="ft-json" aria-selected="true" aria-controls="fp-json">FHIR R4 JSON</button>
            {docs.map((d) => <button class="tab" role="tab" id={`ft-${d.id}`} aria-selected="false" aria-controls={`fp-${d.id}`} tabindex="-1">{d.tab}</button>)}
            <button class="tab" role="tab" id="ft-txt" aria-selected="false" aria-controls="fp-txt" tabindex="-1">Plain text</button>
          </div>
          <div class="tp" role="tabpanel" id="fp-json" aria-labelledby="ft-json">
            <div class="panel">
              <div class="panel-h"><span>DiagnosticReport.json</span><span class="chip chip-draft">Illustrative</span></div>
              <pre class="code fj" tabindex="0" aria-label="Illustrative FHIR R4 DiagnosticReport JSON" set:html={json} />
              <p class="fine">Illustrative example, not patient data. presentedForm.data is base64 and truncated here.</p>
            </div>
          </div>
          {docs.map((d) => (
            <div class="tp" role="tabpanel" id={`fp-${d.id}`} aria-labelledby={`ft-${d.id}`} hidden>
              <div class="panel">
                <div class="panel-h"><span>{d.file}</span><span class="chip chip-draft">Illustrative</span></div>
                <div class="paper">
                  <div class="pp-h"><span>Your department letterhead</span><span>{d.note}</span></div>
                  <p class="pp-t">CT Chest</p>
                  <p class="pp-m">Accession ACC-000123 · Status: Final</p>
                  {sections.map(([t, c]) => <><b>{t}</b><p>{c}</p></>)}
                  <p class="pp-s">Electronically signed by the reporting radiologist</p>
                </div>
              </div>
            </div>
          ))}
          <div class="tp" role="tabpanel" id="fp-txt" aria-labelledby="ft-txt" hidden>
            <div class="panel">
              <div class="panel-h"><span>report.txt</span><span class="chip chip-draft">Illustrative</span></div>
              <pre class="code txt" tabindex="0">{narrative}</pre>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <Divider />

  <section class="sec" id="identity-ai">
    <div class="wrap">
      <SectionHead eyebrow="Identity and AI" title="Your identity provider. Your choice of model." />
      <div class="grid grid-2">
        <article class="card" data-reveal>
          <span class="ic"><Icon name="key" /></span>
          <h3>SSO over OIDC, with MFA</h3>
          <p>Radiologists and administrators sign in through your identity provider.</p>
          <ul class="ticks">
            <li><Icon name="check" />OIDC presets for Keycloak, Auth0 and Okta</li>
            <li><Icon name="check" />MFA enforced through the identity provider's amr claim</li>
            <li><Icon name="check" />TOTP enrollment where an account needs it</li>
            <li><Icon name="check" />A SAML 2.0 service provider is also available</li>
          </ul>
          <a class="more" href="/security/">Security and governance <Icon name="arrow" /></a>
        </article>
        <article class="card" data-reveal>
          <span class="ic"><Icon name="spark" /></span>
          <h3>AI providers</h3>
          <p>Route drafting to a hosted model, or run one inside your network.</p>
          <div class="provs"><span class="prov"><i></i>Anthropic Claude</span><span class="prov"><i></i>Azure OpenAI</span><span class="prov local"><i></i>Ollama, local</span><span class="prov local"><i></i>vLLM, local</span></div>
          <ul class="ticks">
            <li><Icon name="check" />Administrators choose which providers are enabled</li>
            <li><Icon name="check" />Local adapters default to 127.0.0.1</li>
            <li><Icon name="check" />Every call is audited, including whether the request contained PHI</li>
          </ul>
          <a class="more" href="/security/#ai">AI oversight <Icon name="arrow" /></a>
        </article>
      </div>
    </div>
  </section>
  <Divider />

  <section class="sec" id="extend">
    <div class="wrap">
      <SectionHead eyebrow="Extend" title="Signed connectors, and a CLI for the work around reporting." />
      <div class="grid grid-2">
        <article class="card" data-reveal>
          <span class="ic"><Icon name="grid" /></span>
          <h3>Signed connector marketplace</h3>
          <p>Each connector is a JSON manifest with a detached Ed25519 signature. RadioPad re-checks it on registration, and a mismatch blocks the connector and writes an audit entry. Capabilities are deny-by-default.</p>
          <div class="tbl-wrap conn">
            <table class="dtable">
              <caption class="sr">Built-in connectors, all read-only</caption>
              <thead><tr><th scope="col">Built-in connector</th><th scope="col">Scope</th><th scope="col">What it does</th></tr></thead>
              <tbody>
                {connectors.map((c) => <tr><td class="mono">{c.name}</td><td class="mono">{c.scope}</td><td>{c.desc}</td></tr>)}
              </tbody>
            </table>
          </div>
          <a class="more" href="/product/">Platform modules <Icon name="arrow" /></a>
        </article>
        <article class="card" data-reveal>
          <span class="ic"><Icon name="term" /></span>
          <h3>The radiopad CLI</h3>
          <p>A .NET global tool. Author and test rulebooks against golden cases, generate drafts, export and verify the audit log, and check plugin signatures.</p>
          {cli.map((c) => (
            <div class="cli">
              <code><i>$ </i>{c}</code>
              <button class="copy" type="button" data-copy={c}><Icon name="copy" /><span>Copy</span></button>
            </div>
          ))}
          <a class="more" href="/product/validation/#cli">CLI reference <Icon name="arrow" /></a>
        </article>
      </div>
    </div>
  </section>

  <CtaBand lead="Bring your stack." title="We'll map it in the demo." text="Book a walkthrough with your PACS, RIS and identity teams, or try the Windows app on your own workstation." />
</BaseLayout>

<style>
  .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
  .card .ticks{margin:14px 0 4px}
  .card .provs{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
  .card .cli + .cli{margin-top:8px}
  .card .more{margin-top:auto;padding-top:16px}
  .conn{margin-top:14px}
  .conn .dtable{min-width:480px;font-size:.84rem}
  .fx{align-items:start}
  .fx .specs{margin-top:24px}
  .fj{max-height:440px;overflow:auto;font-size:.76rem}
  .txt{white-space:pre-wrap}
  .paper{--ink:var(--on-film);--ink-2:color-mix(in srgb,var(--on-film) 66%,var(--film));border-radius:12px;background:var(--film);color:var(--ink);padding:22px 24px;font-size:.86rem;line-height:1.55;display:grid;gap:4px}
  .paper .pp-h{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;padding-bottom:10px;margin-bottom:8px;border-bottom:2px solid var(--ink);font:500 .68rem var(--font-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--ink-2)}
  .paper .pp-t{font:600 1.2rem var(--font-display);letter-spacing:-.02em;color:var(--ink)}
  .paper .pp-m{font:400 .72rem var(--font-mono);color:var(--ink-2);margin-bottom:6px}
  .paper b{font:600 .66rem var(--font-mono);letter-spacing:.12em;text-transform:uppercase;color:var(--ink-2);margin-top:8px}
  .paper .pp-s{margin-top:14px;padding-top:10px;border-top:1px solid color-mix(in srgb,var(--ink) 20%,transparent);font-style:italic;color:var(--ink-2)}
</style>
