---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import SectionHead from "../../components/SectionHead.astro";
import Divider from "../../components/Divider.astro";
import Faq from "../../components/Faq.astro";
import CtaBand from "../../components/CtaBand.astro";
import Icon from "../../components/Icon.astro";
import { solutions, chestDemo, type Solution } from "../../data/solutions";

export function getStaticPaths() {
  return solutions.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}

const { s } = Astro.props as { s: Solution };
const d = s.demo;
const sev = { blocker: ["f-red", "x", "Blocker"], warning: ["f-amber", "alert", "Warning"] } as const;
---

<BaseLayout title={s.meta} description={s.description}>
  <PageHero
    crumbs={[{ label: s.crumb, href: `/solutions/${s.slug}/` }]}
    eyebrow={s.hero.eyebrow}
    lead={s.hero.lead}
    title={s.hero.title}
    text={s.hero.text}
    ctas={s.primary === "demo"}
  >
    {s.primary === "download" && (
      <div class="cta-row" slot="actions">
        <span class="mag"><a class="btn btn-primary btn-lg" href="/download/"><Icon name="win" /> Download for Windows</a></span>
        <a class="btn btn-ghost btn-lg" href="/pricing/">Free trial details <Icon name="arrow" class="arr" /></a>
      </div>
    )}
  </PageHero>
  <Divider />

  <section class="sec" id="change">
    <div class="wrap">
      <SectionHead eyebrow="What changes for you" title={s.change.title} sub={s.change.sub} />
      <div class="ba">
        <div class="ba-h" aria-hidden="true"><span></span><span>Before</span><span>With RadioPad</span></div>
        {s.change.rows.map((r) => (
          <div class="ba-r" data-reveal>
            <h3>{r.label}</h3>
            <p class="b"><Icon name="x" /><span><span class="sr">Before: </span>{r.before}</span></p>
            <p class="a"><Icon name="check" /><span><span class="sr">With RadioPad: </span>{r.after}</span></p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <Divider />

  <section class="sec" id="demo">
    <div class="wrap">
      <SectionHead eyebrow={d.eyebrow} title={d.title} sub={d.sub} />
      {d.kind === "roles" ? (
        <div data-tabs data-reveal>
          <div class="tabs" role="tablist" aria-label="Roles">
            <span class="tab-ind" aria-hidden="true"></span>
            {d.roles.map((r, i) => (
              <button class="tab" role="tab" id={`rt${i}`} aria-selected={i === 0 ? "true" : "false"} aria-controls={`rp${i}`} tabindex={i === 0 ? undefined : "-1"}>{r.label}</button>
            ))}
          </div>
          {d.roles.map((r, i) => (
            <div class="tp" role="tabpanel" id={`rp${i}`} aria-labelledby={`rt${i}`} hidden={i !== 0}>
              <div class="panel role">
                <div class="panel-h"><span>{r.label}</span><span>{r.items.length} things that change</span></div>
                <ul class="ticks">{r.items.map((it) => <li><Icon name="check" />{it}</li>)}</ul>
                <a class="more" href={r.href}>{r.more} <Icon name="arrow" /></a>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class:list={["rdemo", { wide: d.toggles }]} data-rdemo data-reveal>
          {d.toggles && (
            <div class="panel rb">
              <div class="panel-h"><span>Tenant rulebook</span><span>chest_ct_v1.yaml</span></div>
              <p class="rb-note">Applies to every site and reader in the tenant.</p>
              <div class="rtogs" role="group" aria-label="Rules in chest_ct_v1">
                {chestDemo.rules.map((r) => (
                  <button type="button" class="rtog" data-toggle={r.id} aria-pressed="true"><i aria-hidden="true"></i><code>{r.rule}</code><small>{r.sev}</small></button>
                ))}
              </div>
            </div>
          )}
          <div class="panel">
            <div class="panel-h"><span>CT chest, illustrative draft</span><span>chest_ct_v1</span></div>
            <div class="snippet">
              <b>FINDINGS</b>{chestDemo.findings}
              <b>IMPRESSION <span class="ai-tag"><svg aria-hidden="true"><use href="#i-spark" /></svg><span>AI draft, requires review</span></span></b>
              <span class="ai-text" set:html={chestDemo.impression} />
            </div>
            <ul class="flags">
              {chestDemo.rules.map((r) => {
                const [cls, icon, label] = sev[r.sev as keyof typeof sev];
                return (
                  <li class:list={["flag", cls]} data-flag={r.id} data-sev={r.sev}>
                    <svg class="i sev" aria-hidden="true"><use href={`#i-${icon}`} /></svg>
                    <div><b>{label}</b>{r.text} <code>{r.rule}</code></div>
                    <button class="fix" type="button" data-fix={r.to}>Fix</button>
                  </li>
                );
              })}
            </ul>
            <div class="rp-foot">
              <button class="btn btn-sign" type="button" data-sign><Icon name="pen" /><span>Sign report</span></button>
              <span class="rp-note" data-note aria-live="polite">Only a radiologist can sign. RadioPad never signs.</span>
              <button class="replay" type="button" data-reset aria-label="Reset demo"><Icon name="replay" /></button>
            </div>
          </div>
        </div>
      )}
    </div>
  </section>
  <Divider />

  <section class="sec" id="capabilities">
    <div class="wrap">
      <SectionHead eyebrow="Capabilities" title="What you get on day one." />
      <div class="grid grid-3">
        {s.caps.map((c, i) => (
          <article class:list={["card", { beam: i === 0 }]} data-reveal>
            <span class="ic"><Icon name={c.icon} /></span>
            <h3>{c.title}</h3>
            <p>{c.text}</p>
            <a class="more" href={c.href}>{c.more} <Icon name="arrow" /></a>
          </article>
        ))}
      </div>
    </div>
  </section>
  <Divider />

  <Faq title={s.faqTitle} items={s.faq} />
  <CtaBand lead={s.cta.lead} title={s.cta.title} text={s.cta.text} primary={s.slug === "radiologists" ? "download" : "demo"} />
</BaseLayout>

<script>import "../../scripts/rule-demo.js";</script>

<style>
  .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
  /* before / after rows */
  .ba{border-top:1px solid var(--line)}
  .ba-h,.ba-r{display:grid;grid-template-columns:minmax(0,.7fr) minmax(0,1fr) minmax(0,1fr);gap:clamp(14px,3vw,36px);padding-block:20px;border-bottom:1px solid var(--line)}
  .ba-h{padding-block:12px;font:500 .68rem var(--font-mono);letter-spacing:.12em;text-transform:uppercase;color:var(--fg-3)}
  .ba-r h3{font-size:1.05rem;letter-spacing:-.01em;line-height:1.3}
  .ba-r p{display:flex;gap:10px;align-items:flex-start;font-size:.94rem;line-height:1.55;min-width:0}
  .ba-r p :global(.i){width:16px;height:16px;margin-top:3px}
  .ba-r .b{color:var(--fg-3)}
  .ba-r .a{color:var(--fg)}
  .ba-r .a :global(.i){color:var(--green)}
  @media (max-width:760px){
    .ba-h{display:none}
    .ba-r{grid-template-columns:minmax(0,1fr);gap:8px}
  }
  /* role switcher */
  .role{margin-top:4px;max-width:760px}
  .role .ticks{margin-top:0}
  .role .more{display:inline-flex;align-items:center;gap:6px;font-size:.88rem;color:var(--accent);text-decoration:none}
  .role .more :global(.i){width:15px;height:15px}
  /* rule-impact demo */
  .rdemo{display:grid;grid-template-columns:minmax(0,1fr);gap:14px;max-width:820px}
  .rdemo.wide{grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);max-width:none;align-items:start}
  @media (max-width:860px){.rdemo.wide{grid-template-columns:minmax(0,1fr)}}
  .rb-note{font-size:.88rem;color:var(--fg-2)}
  .rtogs{display:grid;gap:8px}
  .rtog{display:flex;align-items:center;gap:10px;min-height:44px;padding:8px 12px;border-radius:12px;border:1px solid var(--line-2);background:rgba(2,4,8,.35);color:var(--fg-3);font:400 .82rem var(--font-mono);text-align:left;cursor:pointer;transition:border-color .2s ease,color .2s ease}
  .rtog code{flex:1;min-width:0;overflow-wrap:anywhere}
  .rtog small{font-size:.68rem;color:var(--fg-3)}
  .rtog i{flex:none;width:30px;height:18px;border-radius:999px;background:var(--bg-3);position:relative;transition:background-color .2s ease}
  .rtog i::after{content:"";position:absolute;top:3px;left:3px;width:12px;height:12px;border-radius:50%;background:var(--fg-3);transition:transform .25s var(--ease-out),background-color .2s ease}
  .rtog[aria-pressed="true"]{color:var(--fg);border-color:rgba(134,197,255,.35)}
  .rtog[aria-pressed="true"] i{background:rgba(134,197,255,.3)}
  .rtog[aria-pressed="true"] i::after{transform:translateX(12px);background:var(--accent)}
  .rdemo .snippet .ai-tag{margin-left:8px;vertical-align:1px;letter-spacing:.04em}
  .rdemo .snippet .ai-text{display:block;margin-top:6px}
  .rdemo .flag[hidden]{display:none}
  .rdemo .flag code{font:400 .72rem var(--font-mono);color:var(--fg-3);overflow-wrap:anywhere}
  @media (prefers-reduced-motion:reduce){.rtog i,.rtog i::after{transition:none}}
</style>
