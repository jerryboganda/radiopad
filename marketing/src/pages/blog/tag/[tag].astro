---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import Divider from "../../../components/Divider.astro";
import CtaBand from "../../../components/CtaBand.astro";
import PostList from "../../../components/blog/PostList.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({ params: { tag: tag.toLowerCase() }, props: { tag, posts } }));
}

const { tag, posts } = Astro.props;
const n = posts.filter((p) => p.data.tags.includes(tag)).length;
---

<BaseLayout title={`${tag} posts`} description={`RadioPad blog posts tagged ${tag}: notes on AI-assisted radiology reporting.`}>
  <PageHero
    crumbs={[{ label: "Blog", href: "/blog/" }, { label: tag, href: `/blog/tag/${tag.toLowerCase()}/` }]}
    eyebrow="The RadioPad blog"
    lead="Posts tagged"
    title={`${tag}.`}
    text={`${n} ${n === 1 ? "note" : "notes"} tagged ${tag}. Switch tags below, or choose All to see every post.`}
    ctas={false}
  />
  <Divider />
  <section class="sec bl-sec">
    <div class="wrap">
      <h2 class="bl-sr">Posts</h2>
      <PostList posts={posts} active={tag} />
    </div>
  </section>
  <CtaBand />
</BaseLayout>

<style>
  /* one-word tag titles ("Interoperability.") are wider than a 375px screen at hero size */
  :global(.phero-title .l2){hyphens:auto;overflow-wrap:break-word}
</style>
