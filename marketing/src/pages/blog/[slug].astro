---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import { site } from "../../lib/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import CtaBand from "../../components/CtaBand.astro";
import Icon from "../../components/Icon.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );
  // Newest first, so the previous (older) post is the next one in the list.
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, older: posts[i + 1], newer: posts[i - 1] },
  }));
}

const { post, older, newer } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const fmt = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
const iso = (d: Date) => d.toISOString().slice(0, 10);

const canonical = new URL(`/blog/${post.id}/`, site.url).href;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: data.title,
    description: data.description,
    datePublished: data.date.toISOString(),
    dateModified: (data.updated ?? data.date).toISOString(),
    author: { "@type": "Person", name: data.author.name },
    image: new URL(data.cover.src, site.url).href,
    mainEntityOfPage: canonical,
    publisher: { "@type": "Organization", name: site.name, url: site.url },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", site.url).href },
      { "@type": "ListItem", position: 2, name: "Blog", item: new URL("/blog/", site.url).href },
      { "@type": "ListItem", position: 3, name: data.title },
    ],
  },
];
---

<BaseLayout title={data.title} description={data.description} image={data.cover.src} type="article" jsonLd={jsonLd}>
  <article class="post">
    <PageHero crumbs={[{ label: "Blog", href: "/blog/" }]} eyebrow={data.tags.join(" / ")} title={data.title} text={data.description} ctas={false}>
      <div slot="actions" class="post-by">
        <img src={data.author.avatar} alt="" width="44" height="44" />
        <div>
          <b>{data.author.name}</b>
          <span>{data.author.role}</span>
        </div>
        <p class="post-meta">
          <time datetime={iso(data.date)}>{fmt(data.date)}</time>
          <span>{data.readingTime}</span>
          {data.updated && <span>Updated <time datetime={iso(data.updated)}>{fmt(data.updated)}</time></span>}
        </p>
      </div>
      <figure class="post-cover">
        <Image src={data.cover} alt={data.coverAlt} widths={[760, 1240]} sizes="(max-width: 1240px) 100vw, 1176px" loading="eager" />
      </figure>
    </PageHero>

    <section class="post-main">
      <div class="wrap toc-layout">
        {toc.length > 0 && (
          <aside class="toc-rail">
            <nav data-toc aria-label="On this page">
              <p class="toc-h">On this page</p>
              <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
            </nav>
          </aside>
        )}
        <div class="toc-body">
          <div class="prose post-body"><Content /></div>

          <footer class="post-end" data-reveal>
            <ul class="pc-tags" aria-label="Tags">
              {data.tags.map((t) => <li><a class="chip" href={`/blog/tag/${t.toLowerCase()}/`}>{t}</a></li>)}
            </ul>
            <div class="post-author">
              <img src={data.author.avatar} alt="" width="56" height="56" />
              <p>Written by <b>{data.author.name}</b>, {data.author.role}. Published <time datetime={iso(data.date)}>{fmt(data.date)}</time>.</p>
            </div>
            <nav class="post-pager" aria-label="More posts">
              {older && (
                <a class="card" href={`/blog/${older.id}/`} rel="prev"><span class="eyebrow"><Icon name="arrow" class="flip" /> Previous post</span><b>{older.data.title}</b></a>
              )}
              {newer && (
                <a class="card nx" href={`/blog/${newer.id}/`} rel="next"><span class="eyebrow">Next post <Icon name="arrow" /></span><b>{newer.data.title}</b></a>
              )}
            </nav>
          </footer>
        </div>
      </div>
    </section>
  </article>
  <CtaBand lead="See it on your own studies." title="Bring a rulebook to the demo." />
</BaseLayout>

<script>import "../../scripts/toc.js";</script>
